@page "/PlayerCharacters"
@using Blazor_Test.Components.Models
@using Microsoft.EntityFrameworkCore.Internal
@using Microsoft.VisualBasic
@using Microsoft.EntityFrameworkCore;
@rendermode InteractiveServer
@inject IDbContextFactory<Blazor_TestContext> DbFactory

<PageTitle>PlayerCharacters</PageTitle>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4>Player Characters</h4>
            </div>
            <div class="card-body">
                <div class="row">                  
                    <div class="col-md-4">
                        <select class="form-control" placeholder="Select Player" aria-label="Select Player" aria-describedby="button-addon" @onchange="OnPlayerChange">
                            <option value="">-- Select Player --</option>
                            @foreach (var player in playerInfo.Distinct())
                            {
                                <option value="@player.IntPlayerInfoID">@player.PlayerName</option>
                            }
                        </select> 
                    </div>
                    @* <div class="col-md-4">
                        <select class="form-control" placeholder="Select Campaign" aria-label="Select Campaign" aria-describedby="button-addon" @onchange="">
                            <option value="">-- Select Campaign --</option>
                            @foreach (var campaign in campaigns)
                            {
                                <option value="@campaign.IntCampaignID">@campaign.CampaignDescrip</option>
                            }
                        </select> 
                    </div> *@
                    <div class="col-md-4">
                        @* Render the child component here whenever a player is selected *@
                        @if (filteredItems.Any())
                        {
                            <select class="form-control" placeholder="Select Character" aria-label="Select Character" aria-describedby="button-addon" @onchange="OnCharacterChange">
                            <option value="">-- Select Character --</option>
                            @foreach (var character in filteredItems)
                            {
                                <option value="@character.IntPlayerInfoID">@character.CharFirstName @character.CharLastName</option>
                            }
                        </select> 
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>
<br />
<div class="row">
    <div class="col-md-6">
        @* Render the child component here whenever a player is selected *@
        @if (selectedPlayer != null)
        {
            <PlayerDetails Player="@selectedPlayer" />
        }
    </div>
    <div class="col-md-6">
        @if(selectedPlayer != null)
        {
            @if (!string.IsNullOrEmpty(imageSrc))
            {
                <div class="card">
                    <div class="card-body">
                        <img src="@imageSrc" alt="Character Image" width="Auto" height="80%" class="img-fluid" />
                    </div>
                </div>     
            }
            else
            {
                <div class="card">
                    <div class="card-body">
                        <p>No image available.</p>
                    </div>
                </div>              
            }
        }
    </div>
</div>



@code {
    private List<PlayerInfo>? playerInfo = new List<PlayerInfo>();
    public string[]? campaignList;
    public List<Campaigns>? campaigns = new List<Campaigns>();
    private PlayerInfo? selectedCampaign;
    public string[]? playerNameList;
    private PlayerInfo? selectedPlayer;
    private List<CharacterImages> characterImages;
    private string[]? characterList;
    private string? imageSrc;
    private List<PlayerInfo> filteredItems = new List<PlayerInfo>(); 

    protected override async Task OnInitializedAsync()
    {        // Create a short-lived context instance for this operation
        using var context = await DbFactory.CreateDbContextAsync();
        playerInfo = await context.PlayerInfo.Distinct().AsNoTracking().ToListAsync();
        characterImages = await context.CharacterImages.AsNoTracking().ToListAsync();
        campaigns = await context.Campaigns.OrderBy(x => x.IntCampaignID).AsNoTracking().ToListAsync();
    }

    /// <summary>
    /// Displays character details for the selected player
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns> <summary>
    /// 
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>
    private async Task OnPlayerChange(ChangeEventArgs e)
    {
        selectedPlayer = null;
        filteredItems.Clear();

        if (int.TryParse(e.Value?.ToString(), out int playerId))
        {
            using var context = await DbFactory.CreateDbContextAsync();
            filteredItems = await context.PlayerInfo.AsNoTracking().Where(x => x.IntPlayerInfoID == playerId).ToListAsync();
        }
        else
        {
            selectedPlayer = null;
        }

        // Clear the previous selection's image when switching players.
        imageSrc = null;
    }

    private async Task OnCharacterChange(ChangeEventArgs e)
    {
        // Parse the selected option's value (IntPlayerInfoID)
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
        {
            selectedPlayer = playerInfo?.FirstOrDefault(p => p.IntPlayerInfoID == selectedId);
            // Filter FIRST with Where, project with Select, and grab one item with FirstOrDefault
            byte[]? characterImage = characterImages?
                .Where(m => m.IntPlayerInfoID == selectedId)
                .Select(x => x.CharacterImage)
                .FirstOrDefault();

            if (characterImage != null && characterImage.Length > 0)
            {
                // Convert the selected character's image bytes into a data URL for the img element.
                imageSrc = $"data:image/png;base64,{Convert.ToBase64String(characterImage)}"; 
            }
            else
            {
                imageSrc = null;
            }
        }
        else
        {
            selectedPlayer = null;
            imageSrc = null;
        }
    }
}