@page "/playername"
@using Blazor_Test.Components.Models
@using Microsoft.EntityFrameworkCore.Internal
@using Microsoft.VisualBasic
@using Microsoft.EntityFrameworkCore;
@rendermode InteractiveServer
@inject IDbContextFactory<Blazor_TestContext> DbFactory

<PageTitle>Player Names</PageTitle>

<h2>Player Names</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>Generate Names</h4>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header fw-bold">
                                Generate Full Name
                            </div>

                            <div class="card-body">
                                <div class="input-group mb-3">
                                    <button class="btn btn-primary input-group-btn" type="button" id="genFull-button" @onclick="LoadPlayerName">Generate</button>
                                    <input type="text" class="form-control" aria-describedby="genFull-button" value="@playerName" readonly />
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>

                <br />
                
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header fw-bold">
                                Generate Names Separately
                            </div>

                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="input-group mb-3">
                                            <button class="btn btn-primary input-group-btn" type="button" id="genFirst-button" @onclick="LoadPlayerFirstName">Generate First Name</button>
                                            <input type="text" class="form-control" aria-describedby="genFirst-button" value="@firstName" readonly />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="input-group mb-3">
                                            <button class="btn btn-primary input-group-btn" type="button" id="genLast-button" @onclick="LoadPlayerLastName">Generate Last Name</button>
                                            <input type="text" class="form-control" aria-describedby="genLast-button" value="@lastName" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>       
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>Combined Names</h4>
            </div>

            <div class="card-body">
                <table class="table table-sm table-bordered text-center">
                    <tbody>
                        @foreach (var name in combinedNames)
                        {
                            <tr>
                                <td>@name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
    </div>
</div>

