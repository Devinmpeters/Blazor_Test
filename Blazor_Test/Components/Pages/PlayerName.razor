@code {

    private string playerName = string.Empty;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private static List<PlayerNames>? playerNames;
        // Create a list of non-empty first names from the database.
    private string[] firstNames = { "John", "Jane", "Alice", "Bob", "Charlie", "Fenix", "Flikt", "Nithrali", "Reuben", "Calder", "Farlander", "Mavis", "Soldan" };
    private string[] lastNames = { "Doe", "Smith", "Johnson", "Williams", "Brown", "", "Beck", "Daevenna", "Corillian", "Seirinise", "Azorin" };
    private string[] combinedNames = Array.Empty<string>(); // Array to hold combined names
    private PlayerNameModel[] firstLastNames = Array.Empty<PlayerNameModel>(); // Array to hold combined first and last names
    

    // Override the OnInitialized method to populate the combinedNames array when the component is initialized
    protected override void OnInitialized()
    {
        ListPlayerNames();
    }

    protected override async Task OnInitializedAsync()
    {        // Create a short-lived context instance for this operation
        using var context = await DbFactory.CreateDbContextAsync();
        playerNames = await context.PlayerNames.AsNoTracking().ToListAsync();
    }

    // Method to generate a random player name
    private void LoadPlayerName()
    {   
        var firstNameList = playerNames?
            .Select(player => player.FirstName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? new List<string>();
            // Create a list of non-empty first names from the database.

        var lastNameList = playerNames?
            .Select(player => player.LastName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? new List<string>(); 
        // Create a list of non-empty last names from the database.

        var random = new Random(); // Creates a new instance of the Random class
        var firstNameIndex = random.Next(firstNameList.Count); // Generates a random index for the firstNames array
        var lastNameIndex = random.Next(lastNameList.Count); // Generates a random index for the lastNames array

        playerName = $"{firstNameList[firstNameIndex]} {lastNameList[lastNameIndex]}"; // Assigns the randomly selected first and last names to the playerName variable
    }

    // Method to load a random first name
    private void LoadPlayerFirstName()
    {
        var firstNameList = playerNames?
            .Select(player => player.FirstName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? new List<string>();
            // Create a list of non-empty first names from the database.

        if (firstNameList.Count == 0)
        {
            return;
        }

        var random = new Random(); // Creates a new instance of the Random class
        var firstNameIndex = random.Next(firstNameList.Count); // Generates a random index for the first-name list

        firstName = firstNameList[firstNameIndex]; // Assigns the randomly selected first name to the firstName variable
    }

    // Method to load a random last name
    private void LoadPlayerLastName()
    {
        var lastNameList = playerNames?
            .Select(player => player.LastName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? new List<string>(); 
        // Create a list of non-empty last names from the database.

        if (lastNameList.Count == 0)
        {
            return;
        }
        var random = new Random(); // Creates a new instance of the Random class
        var lastNameIndex = random.Next(lastNameList.Count); // Generates a random index for the lastNames array

        lastName = $"{lastNameList[lastNameIndex]}"; // Assigns the randomly selected last name to the lastName variable
    }

    // Method to combine first and last names into a single array
    private void ListPlayerNames()
    {
        var firstNameList = playerNames?
            .Select(player => player.FirstName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? new List<string>();
            // Create a list of non-empty first names from the database.

        var lastNameList = playerNames?
            .Select(player => player.LastName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList() ?? new List<string>(); 
        // Create a list of non-empty last names from the database.

        
        var nameCount = Math.Max(firstNameList.Count, lastNameList.Count); // Determines the maximum length between firstNames and lastNames arrays
        combinedNames = Enumerable.Range(0, nameCount)
            .Select(index =>
            {
                var first = index < firstNameList.Count ? firstNameList[index] : string.Empty; // Selects the first name if the index is within bounds, otherwise assigns an empty string
                var last = index < lastNameList.Count ? lastNameList[index] : string.Empty; // Selects the last name if the index is within bounds, otherwise assigns an empty string
                return $"{first} {last}".Trim(); // Combines the first and last names, trimming any leading or trailing whitespace
            })
            .ToArray(); // Converts the combined names into an array
    }

    // Method to combine first and last names into a single array
    @* private void ListFirstLastNames()
    {
        PlayerNameModel[] firstLastNames = new PlayerNameModel[firstNames.Length];
        for (int i = 0; i < firstNames.Length; i++)
        {
            firstLastNames[i] = new PlayerNameModel
            {
                FirstName = firstNames[i],
                LastName = i < lastNames.Length ? lastNames[i] : string.Empty // Assigns the last name if the index is within bounds, otherwise assigns an empty string
            };
        }
    } *@

    public class PlayerNameModel
    {
        public string FirstName { get; set; } = string.Empty; // Property to hold the first name
        public string LastName { get; set; } = string.Empty; // Property to hold the last name
    }
}