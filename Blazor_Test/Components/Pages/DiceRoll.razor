@page "/diceroll"
@rendermode InteractiveServer

<PageTitle>DiceRoll</PageTitle>

<h1>Dice Roll</h1>

<p role="status">Current Roll: @currentRoll</p>

<button class="btn btn-primary" @onclick="DiceResult">Click me</button>

@code {
    int currentRoll;

    // Method to generate a random dice roll between 1 and 20
    private void DiceResult()
    {
        currentRoll = Random.Shared.Next(1, 21); // Generates a random number between 1 and 20
    }
}
