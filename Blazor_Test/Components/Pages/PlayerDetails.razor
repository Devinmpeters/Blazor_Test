@* For "partial views" do NOT inlcude @page *@
@using Blazor_Test.Components.Models
@using Microsoft.EntityFrameworkCore.Internal
@using Microsoft.VisualBasic
@using Microsoft.EntityFrameworkCore;
@rendermode InteractiveServer
@inject IDbContextFactory<Blazor_TestContext> DbFactory

<PageTitle>PlayerDetails</PageTitle>

@* PlayerDetails.razor *@
@if (Player != null)
{
    <div class="card">
        <div class="card-header">
            <h4>Character Details</h4>
        </div>
        <div class="card-body">
            <form>
                <div class="form-group row mb-3">
                    <label for="characterName" class="col-sm-2 col-form-label fw-bold">Name</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="characterName" readonly value="@Player.CharFirstName @Player.CharLastName" />                   
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <label for="playerRace" class="col-sm-2 col-form-label fw-bold">Race</label>
                    <div class="col-sm-10"x>
                        <input type="text" class="form-control" id="playerRace" readonly value="@Player.CharRace" />
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <label for="playerClass" class="col-sm-2 col-form-label fw-bold">Class</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="playerRace" readonly value="@Player.CharClass" />
                    </div>
                </div>  
                <div class="form-group row mb-3">
                    <label for="playerSubClass" class="col-sm-2 col-form-label fw-bold">Sub Class</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="playerSubClass" readonly value="@Player.CharSubClass" />
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label for="playerBackground" class="col-sm-2 col-form-label fw-bold"> Background</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="playerBackground" readonly value="@Player.CharBackground" />
                    </div>
                </div>  
                <div class="form-group row mb-3">
                    <label for="playerLevel" class="col-sm-2 col-form-label fw-bold">Level</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="playerLevel" readonly value="@Player.CharLevel" />
                    </div>
                </div>     
            </form>         
        </div>
    </div>
}


@code {
    [Parameter]
    public PlayerInfo? Player { get; set; }
}